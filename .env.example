# Twilio (system-wide default; a Church row can override the "from" number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Resend (system-wide default; a Church row can override from-email/name)
# RESEND_FROM_EMAIL must be on a domain you've verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Church Team

# Database - defaults to local SQLite file if unset.
# On Render, set this to your Postgres connection string.
DATABASE_URL=sqlite:///./newcomer_reminders.db
